// convertNetworkInterfaces converts NetworkConfiguration interfaces to NetworkInfo interfaces
func convertNetworkInterfaces(config *fingerprint.NetworkConfiguration) []*fingerprint.NetworkInterface {
	if config == nil {
		return nil
	}

	interfaces := make([]*fingerprint.NetworkInterface, len(config.Interfaces))
	for i, iface := range config.Interfaces {
		interfaces[i] = &fingerprint.NetworkInterface{
			Name:          iface.Name,
			DisplayName:   iface.DisplayName,
			MACAddress:    iface.MACAddress,
			IPv4Addresses: iface.IPv4Addresses,
			IPv6Addresses: iface.IPv6Addresses,
			State:         iface.State,
			Type:          iface.Type,
			Speed:         iface.Speed,
			MTU:           iface.MTU,
			Statistics:    iface.Statistics,
		}
	}
	return interfaces
}

// convertRouteEntries converts NetworkConfiguration routing table to RouteEntry slice
func convertRouteEntries(config *fingerprint.NetworkConfiguration) []*fingerprint.RouteEntry {
	if config == nil {
		return nil
	}

	routes := make([]*fingerprint.RouteEntry, len(config.RoutingTable))
	for i, route := range config.RoutingTable {
		routes[i] = &fingerprint.RouteEntry{
			Destination: route.Destination,
			Gateway:     route.Gateway,
			Interface:   route.Interface,
			Metric:      route.Metric,
			Type:        route.Type,
		}
	}
	return routes
}

// convertDNSConfig converts NetworkConfiguration DNS servers to DNSConfig
func convertDNSConfig(config *fingerprint.NetworkConfiguration) *fingerprint.DNSConfig {
	if config == nil || len(config.DNSServers) == 0 {
		return nil
	}

	return &fingerprint.DNSConfig{
		Servers: config.DNSServers,
	}
}

// gatherEnhancedPlatformPackages routes to the OS-specific enhanced package gathering function.
func (c *ScanCommand) gatherEnhancedPlatformPackages(ctx context.Context, agentInfo commands.AgentInfo, result *ScanResult) ([]EnhancedPackageInfo, error) {
	switch runtime.GOOS {
	case "linux":
		return gatherEnhancedLinuxPackages(ctx, agentInfo, result)
	case "windows":
		return gatherEnhancedWindowsPackages(ctx, agentInfo, result)
	case "darwin":
		return gatherEnhancedMacOSPackages(ctx, agentInfo, result)
	default:
		msg := fmt.Sprintf("Enhanced package gathering not supported for OS: %s", runtime.GOOS)
		result.ScanErrors = append(result.ScanErrors, msg)
		return nil, fmt.Errorf(msg)
	}
}

// convertScanResultToHostWithJSONB converts a ScanResult to a sirius.Host with separated JSONB data
func (c *ScanCommand) convertScanResultToHostWithJSONB(agentInfo commands.AgentInfo, result *ScanResult) (sirius.Host, map[string]interface{}, map[string]interface{}, map[string]interface{}, error) {
	host := sirius.Host{
		HID:       agentInfo.Config.HostID,
		OS:        result.OSInfo.OS,
		OSVersion: result.OSInfo.Version,
		IP:        result.OSInfo.PrimaryIP,
		Hostname:  result.OSInfo.Hostname,
	}

	// Prepare JSONB data structures
	softwareInventory := make(map[string]interface{})
	systemFingerprint := make(map[string]interface{})
	agentMetadata := make(map[string]interface{})

	// Populate software inventory from enhanced packages
	if len(result.EnhancedPackages) > 0 {
		softwareInventory["packages"] = result.EnhancedPackages
		softwareInventory["package_count"] = len(result.EnhancedPackages)
		softwareInventory["collected_at"] = time.Now().UTC()
		softwareInventory["source"] = "sirius-agent"

		// Add package statistics
		stats := make(map[string]interface{})
		architectures := make(map[string]int)
		publishers := make(map[string]int)

		for _, pkg := range result.EnhancedPackages {
			if pkg.Architecture != "" {
				architectures[pkg.Architecture]++
			}
			if pkg.Publisher != "" {
				publishers[pkg.Publisher]++
			}
		}

		stats["architectures"] = architectures
		stats["publishers"] = publishers
		softwareInventory["statistics"] = stats
	}

	// Populate system fingerprint
	if result.SystemFingerprint != nil {
		systemFingerprint["fingerprint"] = result.SystemFingerprint
		systemFingerprint["collected_at"] = time.Now().UTC()
		systemFingerprint["source"] = "sirius-agent"
		systemFingerprint["platform"] = result.SystemFingerprint.Platform
		systemFingerprint["collection_duration_ms"] = result.SystemFingerprint.CollectionDuration.Milliseconds()

		// Add summary information
		summary := make(map[string]interface{})
		if result.SystemFingerprint.Hardware != nil {
			summary["has_cpu_info"] = result.SystemFingerprint.Hardware.CPU != nil
			summary["has_memory_info"] = result.SystemFingerprint.Hardware.Memory != nil
			summary["storage_devices"] = len(result.SystemFingerprint.Hardware.Storage)
			summary["has_system_info"] = result.SystemFingerprint.Hardware.System != nil
		}
		if result.SystemFingerprint.Network != nil {
			summary["network_interfaces"] = len(result.SystemFingerprint.Network.Interfaces)
			summary["routing_entries"] = len(result.SystemFingerprint.Network.Routes)
			summary["has_dns_config"] = result.SystemFingerprint.Network.DNS != nil
		}
		systemFingerprint["summary"] = summary
	}

	// Populate agent metadata
	agentMetadata["agent_id"] = agentInfo.Config.AgentID
	agentMetadata["host_id"] = agentInfo.Config.HostID
	agentMetadata["scan_timestamp"] = time.Now().UTC()
	agentMetadata["agent_version"] = "1.0.0" // TODO: Get from build info
	agentMetadata["platform"] = runtime.GOOS
	agentMetadata["architecture"] = runtime.GOARCH

	// Add scan summary
	scanSummary := make(map[string]interface{})
	scanSummary["packages_collected"] = len(result.Packages)
	scanSummary["enhanced_packages_collected"] = len(result.EnhancedPackages)
	scanSummary["fingerprint_collected"] = result.SystemFingerprint != nil
	scanSummary["custom_scripts_executed"] = len(result.CustomResults)
	scanSummary["scan_errors"] = len(result.ScanErrors)
	if len(result.ScanErrors) > 0 {
		scanSummary["error_details"] = result.ScanErrors
	}
	agentMetadata["scan_summary"] = scanSummary

	return host, softwareInventory, systemFingerprint, agentMetadata, nil
}

// convertScanResultToHost converts a ScanResult to a sirius.Host with populated JSONB fields
func (c *ScanCommand) convertScanResultToHost(agentInfo commands.AgentInfo, result *ScanResult) (sirius.Host, error) {
	host, _, _, _, err := c.convertScanResultToHostWithJSONB(agentInfo, result)
	return host, err
}

// executeTemplateDetection performs template-based vulnerability detection
func (c *ScanCommand) executeTemplateDetection(ctx context.Context, agentInfo commands.AgentInfo, result *ScanResult) ([]TemplateDetectionResult, error) {
	agentInfo.Logger.Info("Initializing template-based vulnerability detection")

	// Create context with timeout for entire template detection process
	templateCtx, cancel := context.WithTimeout(ctx, 5*time.Minute)
	defer cancel()

	// Get template directories (relative to agent executable)
	templateDirs := c.getTemplateDirs()
	agentInfo.Logger.Info("Template directories resolved", zap.Strings("template_dirs", templateDirs))

	// Verify template directories exist and are accessible
	accessibleDirs := make([]string, 0, len(templateDirs))
	for _, templateDir := range templateDirs {
		// Test directory access with timeout
		dirTestCtx, dirCancel := context.WithTimeout(templateCtx, 10*time.Second)
		accessible := make(chan bool, 1)

		go func(dir string) {
			if _, err := os.Stat(dir); err == nil {
				accessible <- true
			} else {
				accessible <- false
			}
		}(templateDir)

		select {
		case isAccessible := <-accessible:
			if isAccessible {
				accessibleDirs = append(accessibleDirs, templateDir)
				agentInfo.Logger.Info("Template directory accessible", zap.String("dir", templateDir))
			} else {
				agentInfo.Logger.Warn("Template directory not accessible", zap.String("dir", templateDir))
			}
		case <-dirTestCtx.Done():
			agentInfo.Logger.Warn("Template directory access test timed out", zap.String("dir", templateDir))
		}
		dirCancel()
	}

	if len(accessibleDirs) == 0 {
		agentInfo.Logger.Warn("No accessible template directories found", zap.Strings("attempted_dirs", templateDirs))
		return []TemplateDetectionResult{}, nil
	}

	// Create template executor with accessible directories
	executor := template.NewTemplateExecutor(agentInfo.Logger, accessibleDirs)
	executor.SetTimeout(2 * time.Minute) // Set execution timeout

	// Load templates with timeout protection
	agentInfo.Logger.Info("Loading templates from accessible directories", zap.Strings("dirs", accessibleDirs))

	// Create separate context for template loading
	loadCtx, loadCancel := context.WithTimeout(templateCtx, 2*time.Minute)
	defer loadCancel()

	templates, err := executor.LoadTemplates(loadCtx)
	if err != nil {
		return nil, fmt.Errorf("failed to load templates: %w", err)
	}

	if len(templates) == 0 {
		agentInfo.Logger.Warn("No templates found for execution", zap.Strings("template_dirs", accessibleDirs))
		return []TemplateDetectionResult{}, nil
	}

	agentInfo.Logger.Info("Templates loaded for execution",
		zap.Int("total_templates", len(templates)),
		zap.Strings("template_dirs", accessibleDirs))

	// Execute templates with timeout protection
	agentInfo.Logger.Info("Starting template execution phase")

	// Create separate context for template execution
	execCtx, execCancel := context.WithTimeout(templateCtx, 2*time.Minute)
	defer execCancel()

	detectionResults, err := executor.ExecuteTemplates(execCtx, templates)
	if err != nil {
		return nil, fmt.Errorf("template execution failed: %w", err)
	}

	agentInfo.Logger.Info("Template execution completed",
		zap.Int("templates_executed", len(templates)),
		zap.Int("results_generated", len(detectionResults)))

	// Convert detection results to scan results format
	scanResults := make([]TemplateDetectionResult, len(detectionResults))
	for i, detectionResult := range detectionResults {
		scanResults[i] = c.convertDetectionResult(detectionResult)
	}

	return scanResults, nil
}

// getTemplateDirs returns template directories relative to agent executable
func (c *ScanCommand) getTemplateDirs() []string {
	// For Windows, prioritize local paths and avoid network shares
	if runtime.GOOS == "windows" {
		// Check if we're in a problematic network environment
		devTemplateDir := "/app-agent/templates"
		if absPath, err := filepath.Abs(devTemplateDir); err == nil {
			// Detect network paths (UNC paths starting with \\) and skip them
			if strings.HasPrefix(absPath, `\\`) {
				// Skip network paths and use local fallback
			} else if _, err := os.Stat(devTemplateDir); err == nil {
				return []string{devTemplateDir}
			}
		}

		// Try current working directory first on Windows
		if cwd, err := os.Getwd(); err == nil {
			cwdTemplateDir := filepath.Join(cwd, "templates")
			if absPath, err := filepath.Abs(cwdTemplateDir); err == nil {
				// Only use if it's not a network path
				if !strings.HasPrefix(absPath, `\\`) {
					if _, err := os.Stat(cwdTemplateDir); err == nil {
						return []string{cwdTemplateDir}
					}
				}
			}
		}

		// Try relative to where agent is likely deployed
		commonPaths := []string{
			"templates",
			"./templates",
			"../templates",
			"C:\\Program Files\\Sirius\\Agent\\templates",
			"C:\\Sirius\\Agent\\templates",
		}

		for _, templatePath := range commonPaths {
			if absPath, err := filepath.Abs(templatePath); err == nil {
				// Only use local paths, avoid network shares
				if !strings.HasPrefix(absPath, `\\`) {
					if _, err := os.Stat(templatePath); err == nil {
						return []string{absPath}
					}
				}
			}
		}

		// Fallback: create an empty templates directory in current working directory
		if cwd, err := os.Getwd(); err == nil {
			templateDir := filepath.Join(cwd, "templates")
			if absPath, err := filepath.Abs(templateDir); err == nil {
				// Only use if it's not a network path
				if !strings.HasPrefix(absPath, `\\`) {
					os.MkdirAll(templateDir, 0755) // Create if it doesn't exist
					return []string{templateDir}
				}
			}
		}

		// Ultimate fallback for Windows - use a safe local path
		return []string{"templates"}
	}

	// For non-Windows systems, use the original logic
	// First, try the development/source directory (for container development)
	devTemplateDir := "/app-agent/templates"
	if _, err := os.Stat(devTemplateDir); err == nil {
		return []string{devTemplateDir}
	}

	// Fallback to executable-relative directory (for production deployment)
	exePath, err := os.Executable()
	if err != nil {
		// Final fallback to current working directory
		return []string{"templates"}
	}

	// Resolve any symlinks to get the real executable path
	realExePath, err := filepath.EvalSymlinks(exePath)
	if err == nil {
		exePath = realExePath
	}

	exeDir := filepath.Dir(exePath)
	templateDir := filepath.Join(exeDir, "templates")

	// Ensure the template directory exists
	if _, err := os.Stat(templateDir); os.IsNotExist(err) {
		// Try to create it
		if mkdirErr := os.MkdirAll(templateDir, 0755); mkdirErr != nil {
			// If we can't create it, fallback to current directory
			return []string{"templates"}
		}
	}

	return []string{templateDir}
}

// convertDetectionResult converts detect.DetectionResult to TemplateDetectionResult
func (c *ScanCommand) convertDetectionResult(result *detect.DetectionResult) TemplateDetectionResult {
	scanResult := TemplateDetectionResult{
		TemplateID:      result.SourceID,
		VulnerabilityID: result.VulnerabilityID,
		Vulnerable:      result.Vulnerable,
		Confidence:      result.Confidence,
		Severity:        string(result.Severity),
		DetectionType:   string(result.Method),
		ExecutedAt:      result.ExecutedAt,
		ExecutionTime:   result.ExecutionTime,
		Error:           result.Error,
		Metadata:        result.Metadata,
	}

	// Convert evidence
	scanResult.Evidence = make([]DetectionEvidence, len(result.Evidence))
	for i, evidence := range result.Evidence {
		scanResult.Evidence[i] = DetectionEvidence{
			Type:        string(evidence.Type),
			Location:    evidence.Location,
			Expected:    evidence.Expected,
			Actual:      evidence.Actual,
			Description: evidence.Description,
			Context:     evidence.Context,
		}
	}

	// Extract template name from metadata if available
	if templateName, ok := result.Metadata["template_name"].(string); ok {
		scanResult.TemplateName = templateName
	} else {
		scanResult.TemplateName = result.SourceID // Fallback to ID
	}

	return scanResult
}

// countVulnerableTemplates counts how many templates detected vulnerabilities
func countVulnerableTemplates(results []TemplateDetectionResult) int {
	count := 0
	for _, result := range results {
		if result.Vulnerable {
			count++
		}
	}
	return count
}

// createScanSummaryResult creates a summarized result for regular scans
func createScanSummaryResult(result *ScanResult) map[string]interface{} {
	summary := make(map[string]interface{})

	// Template Detection Results - always show if any exist
	if len(result.TemplateDetectionResults) > 0 {
		templateSummary := make(map[string]interface{})
		templateSummary["total_templates"] = len(result.TemplateDetectionResults)
		templateSummary["vulnerable_found"] = countVulnerableTemplates(result.TemplateDetectionResults)
		templateSummary["successful_ids"] = getSuccessfulTemplateIDs(result.TemplateDetectionResults)
		// Only include detailed results if there are vulnerabilities found
		if countVulnerableTemplates(result.TemplateDetectionResults) > 0 {
			templateSummary["vulnerability_details"] = getVulnerabilityDetails(result.TemplateDetectionResults)
		}
		summary["template_detection"] = templateSummary
	}

	// Basic System Information
	summary["system_info"] = map[string]interface{}{
		"os_info":     result.OSInfo,
		"fingerprint": result.SystemFingerprint,
	}

	// Package Statistics (not full package list)
	packageStats := make(map[string]interface{})
	if len(result.EnhancedPackages) > 0 {
		packageStats["total_packages"] = len(result.EnhancedPackages)
		packageStats["sources"] = getPackageSourceSummary(result.EnhancedPackages)
		packageStats["architectures"] = getPackageArchitectureSummary(result.EnhancedPackages)
	} else if len(result.Packages) > 0 {
		packageStats["total_packages"] = len(result.Packages)
		packageStats["sources"] = getBasicPackageSourceSummary(result.Packages)
	} else {
		packageStats["total_packages"] = 0
		packageStats["sources"] = map[string]int{}
	}
	summary["package_statistics"] = packageStats

	// Scan Summary
	scanSummary := make(map[string]interface{})
	scanSummary["errors"] = result.ScanErrors
	scanSummary["error_count"] = len(result.ScanErrors)
	summary["scan_summary"] = scanSummary

	return summary
}

// getSuccessfulTemplateIDs returns IDs of templates that detected vulnerabilities
func getSuccessfulTemplateIDs(results []TemplateDetectionResult) []string {
	var successIDs []string
	for _, result := range results {
		if result.Vulnerable {
			successIDs = append(successIDs, result.TemplateID)
		}
	}
	return successIDs
}

// getPackageSourceSummary returns package count by source from enhanced packages
func getPackageSourceSummary(packages []EnhancedPackageInfo) map[string]int {
	summary := make(map[string]int)
	for _, pkg := range packages {
		summary[pkg.Source]++
	}
	return summary
}

// getPackageArchitectureSummary returns package count by architecture from enhanced packages
func getPackageArchitectureSummary(packages []EnhancedPackageInfo) map[string]int {
	summary := make(map[string]int)
	for _, pkg := range packages {
		if pkg.Architecture != "" {
			summary[pkg.Architecture]++
		}
	}
	return summary
}

// getBasicPackageSourceSummary returns package count by source from basic packages
func getBasicPackageSourceSummary(packages []InstalledPackage) map[string]int {
	summary := make(map[string]int)
	for _, pkg := range packages {
		summary[pkg.Source]++
	}
	return summary
}

// getVulnerabilityDetails returns essential details for templates that found vulnerabilities
func getVulnerabilityDetails(results []TemplateDetectionResult) []map[string]interface{} {
	var details []map[string]interface{}
	for _, result := range results {
		if result.Vulnerable {
			detail := map[string]interface{}{
				"template_id":      result.TemplateID,
				"template_name":    result.TemplateName,
				"vulnerability_id": result.VulnerabilityID,
				"confidence":       result.Confidence,
				"severity":         result.Severity,
			}
			details = append(details, detail)
		}
	}
	return details
}


// convertSeverityToRiskScore converts severity strings to CVSS-like risk scores
func convertSeverityToRiskScore(severity string) float64 {
	switch strings.ToLower(severity) {
	case "critical":
		return 9.0
	case "high":
		return 7.5
	case "medium":
		return 5.0
	case "low":
		return 2.5
	case "info", "informational":
		return 1.0
	default:
		return 5.0 // Default to medium if unknown
	}
}
